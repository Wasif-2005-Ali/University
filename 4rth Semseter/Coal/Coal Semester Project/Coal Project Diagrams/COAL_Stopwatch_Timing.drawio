        <mxCell id="c1" value="&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;; ─── Called from HandleInput on SPACE key ──────────────────────────────────&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="684" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;font color=&quot;#00C2A8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;ToggleStopwatch:&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="704" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;font color=&quot;#A8D8B8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    cmp   currentMode, 1&lt;/font&gt;&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;          ; guard — only active in Stopwatch mode&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="722" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;font color=&quot;#A8D8B8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    jne   NoInput&lt;/font&gt;&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;                    ; ignore key if not in mode 1&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="740" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;font color=&quot;#F0A500&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    xor   swState, 1&lt;/font&gt;&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;             ; flip: 0→1 (start) or 1→0 (pause)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="758" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;font color=&quot;#A8D8B8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    cmp   swState, 1&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="776" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;font color=&quot;#A8D8B8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    jne   Pausing&lt;/font&gt;&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;                ; swState is now 0 → go to pause handler&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="794" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    ; ── START path ─────────────────────────────────────────────────────────&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="816" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;font color=&quot;#39D98A&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    call  GetMSeconds&lt;/font&gt;&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;             ; read current ms counter from system&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="834" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;font color=&quot;#39D98A&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    mov   timeStart, eax&lt;/font&gt;&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;          ; snapshot start timestamp&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="852" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;font color=&quot;#A8D8B8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    ret&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="870" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    ; ── PAUSE path ──────────────────────────────────────────────────────────&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="892" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;font color=&quot;#F0A500&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;Pausing:&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="910" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;font color=&quot;#F0A500&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    call  GetMSeconds&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="928" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;font color=&quot;#F0A500&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    sub   eax, timeStart&lt;/font&gt;&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;          ; duration of this run segment&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="946" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;font color=&quot;#F0A500&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    add   timeElapsed, eax&lt;/font&gt;&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;        ; accumulate into total&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="964" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;font color=&quot;#A8D8B8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    ret&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="982" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    ; ── RESET ───────────────────────────────────────────────────────────────&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="1004" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;font color=&quot;#F07070&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;ResetStopwatch:&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="1022" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;font color=&quot;#F07070&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    mov   swState,     0&lt;/font&gt;&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;          ; force idle&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="1040" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;font color=&quot;#F07070&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    mov   timeElapsed, 0&lt;/font&gt;&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;          ; clear accumulated time&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="1058" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;font color=&quot;#F07070&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    mov   timeStart,   0&lt;/font&gt;&lt;font color=&quot;#7B9BB8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;          ; clear start snapshot&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="1076" width="790" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;font color=&quot;#A8D8B8&quot; style=&quot;font-size:11px;font-family:Courier New;&quot;&gt;    ret&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="800" y="1094" width="790" height="18" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
