package View;

import javax.swing.*;
import Controller.UserController;
import Model.User;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class LoginPage extends JFrame {

    public LoginPage() {
        setTitle("PharmaEase - Sign In");
        setExtendedState(JFrame.MAXIMIZED_BOTH);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(new GridBagLayout()); // Center everything
        setUndecorated(false);

        // Central Panel
        JPanel mainPanel = new JPanel();
        mainPanel.setPreferredSize(new Dimension(400, 400));
        mainPanel.setBackground(Color.WHITE);
        mainPanel.setLayout(null); // Manual positioning

        JLabel titleLabel = new JLabel("Sign In");
        titleLabel.setForeground(new Color(0, 150, 20));
        titleLabel.setFont(new Font("Arial", Font.BOLD, 30));
        titleLabel.setBounds(140, 20, 200, 40);

        JLabel userLabel = new JLabel("Username:");
        userLabel.setBounds(40, 90, 100, 25);
        JTextField usernameField = new JTextField();
        usernameField.setBounds(140, 90, 200, 30);

        JLabel passLabel = new JLabel("Password:");
        passLabel.setBounds(40, 140, 100, 25);
        JPasswordField passwordField = new JPasswordField();
        passwordField.setBounds(140, 140, 200, 30);

        JButton fpBtn = new JButton("Forgot your Password?");
        fpBtn.setBounds(140, 180, 200, 25);
        fpBtn.setBorderPainted(false);
        fpBtn.setFocusPainted(false);
        fpBtn.setContentAreaFilled(false);
        fpBtn.setForeground(new Color(30, 30, 30));

        JButton loginBtn = new JButton("Sign In");
        loginBtn.setBounds(140, 220, 200, 35);

        JLabel signupMsg = new JLabel("New user?");
        signupMsg.setBounds(100, 270, 100, 30);

        JButton signupBtn = new JButton("Sign Up");
        signupBtn.setBounds(170, 270, 100, 30);

        // Add components
        mainPanel.add(titleLabel);
        mainPanel.add(userLabel);
        mainPanel.add(usernameField);
        mainPanel.add(passLabel);
        mainPanel.add(passwordField);
        mainPanel.add(fpBtn);
        mainPanel.add(loginBtn);
        mainPanel.add(signupMsg);
        mainPanel.add(signupBtn);

        // Center the panel in JFrame
        add(mainPanel, new GridBagConstraints());

        // Login button logic
        loginBtn.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                String userName = usernameField.getText().trim();
                char[] passwordChars = passwordField.getPassword();
                String password = new String(passwordChars).trim();

                if (userName.isEmpty() || password.isEmpty()) {
                    JOptionPane.showMessageDialog(null, "Please enter credentials", "Missing Info", JOptionPane.WARNING_MESSAGE);
                    return;
                }

                if (new UserController().validateLogin(userName, password)) {
                    JOptionPane.showMessageDialog(null, "Login successful");
                    java.util.Arrays.fill(passwordChars, '0');

                    UserController controlUserRole = new UserController();
                    User user = controlUserRole.getUserByUsername(userName);

                    dispose(); // Close login page

                    if (user.getUserTypeId() == 1) {
                        SwingUtilities.invokeLater(() -> {
                            try {
                                UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
                            } catch (Exception f) {
                                f.printStackTrace();
                            }
                            new CustomerDashboard().setVisible(true);
                        });
                    } else if (user.getUserTypeId() == 2) {
                        new SellerDashBoard(user);
                    } else if (user.getUserTypeId() == 3) {
                        new AdminDashboard(user);
                    } else {
                        JOptionPane.showMessageDialog(null, "User type not found");
                    }
                } else {
                    JOptionPane.showMessageDialog(null, "Invalid credentials", "Error", JOptionPane.ERROR_MESSAGE);
                }
            }
        });

        // Sign up button logic
        signupBtn.addActionListener(e -> {
            dispose();
            new SignUpPage();
        });

        setVisible(true);
    }
}
