        <mxCell id="qgo6AhQ3c0XN2zxo103C-21" value="&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Calculate CO2 Emissions for All Activities:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Car Travel = Car Travel Distance (km) * 0.21 kg CO2&lt;/li&gt;&lt;li&gt;Electricity Usage = Electricity (kWh) * 0.45 kg CO2&lt;/li&gt;&lt;li&gt;Flight = Flight Distance (km) * 0.13 kg CO2&lt;/li&gt;&lt;li&gt;Heating = Heating (hours) * 0.25&lt;/li&gt;&lt;li&gt;Cooking = Cooking (hours) * 0.15&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;fontColor=#0b0909;" parent="1" vertex="1">
          <mxGeometry x="302.5" y="640" width="330" height="112" as="geometry" />
        </mxCell>
        <mxCell id="qgo6AhQ3c0XN2zxo103C-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=#000000;strokeWidth=2;" parent="1" source="qgo6AhQ3c0XN2zxo103C-24" target="qgo6AhQ3c0XN2zxo103C-27" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="424.52631578947376" y="870" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qgo6AhQ3c0XN2zxo103C-24" value="&lt;b&gt;Total Emissions&lt;/b&gt; = Car Travel Emissions + Electricity Usage&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Emissions + Flight Emission + Heating&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Emission + Cooking Emission" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;fontColor=#0b0909;" parent="1" vertex="1">
          <mxGeometry x="287.5" y="780" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="qgo6AhQ3c0XN2zxo103C-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#000000;" parent="1" source="qgo6AhQ3c0XN2zxo103C-27" target="qgo6AhQ3c0XN2zxo103C-29" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="424.52631578947376" y="1000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qgo6AhQ3c0XN2zxo103C-27" value="&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;b&gt;&lt;i&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Calculate AQI&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;If &lt;/b&gt;Total Emissions &amp;lt;= 50:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;b&gt;AQI &lt;/b&gt;= Total Emissions * 10&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&lt;b&gt;Else If &lt;/b&gt;Total Emissions &amp;lt;= 250:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;b&gt;AQI &lt;/b&gt;= 100 + (Total Emissions - 50) * 2&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&lt;b&gt;Else&lt;/b&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;b&gt;AQI &lt;/b&gt;= 300 + (Total Emissions - 250) * 1.5&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#000000;fontColor=#0b0909;" parent="1" vertex="1">
          <mxGeometry x="340" y="870" width="255" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mng-37eDqhTHqq2VEjSK-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=#000000;strokeWidth=2;" parent="1" source="qgo6AhQ3c0XN2zxo103C-29" target="qgo6AhQ3c0XN2zxo103C-45" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qgo6AhQ3c0XN2zxo103C-29" value="&lt;div&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Calculate Climte Change Impact&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Climate Change Impact = log(Total Emissions + 1) * 10&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;fontColor=#0b0909;" parent="1" vertex="1">
